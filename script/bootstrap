#!/usr/bin/env bash
# Installs everything needed to build Pensive on Debian or Ubuntu.
set -euo pipefail

packages=(build-essential libfontconfig-dev libxkbcommon-x11-dev mesa-vulkan-drivers)

if ! command -v apt-get >/dev/null; then
  echo "script/bootstrap only supports Debian and Ubuntu so far." >&2
  echo "Install your system's equivalents of: ${packages[*]}" >&2
  exit 1
fi

sudo apt-get update
sudo apt-get install -y "${packages[@]}"

if ! command -v rustup >/dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  echo "Rust installed. Open a new terminal before running cargo."
fi
