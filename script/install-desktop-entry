#!/usr/bin/env bash
# Installs Pensive's desktop entry and icon for the current user on Linux.
# Wayland compositors find a window's icon through the desktop entry named after its app id,
# so the file must stay `pensive.desktop` while `window_options` sets the app id to `pensive`.
set -euo pipefail

cd "$(dirname "$0")/.."
data_home=${XDG_DATA_HOME:-$HOME/.local/share}

install -Dm644 crates/pensive/resources/linux/pensive.desktop "$data_home/applications/pensive.desktop"
install -Dm644 assets/icon.svg "$data_home/icons/hicolor/scalable/apps/pensive.svg"

echo "Installed into $data_home. Windows opened from now on show the Pensive icon."
